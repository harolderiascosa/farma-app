  <key>Label</key><string>com.stock.server</string>\
  <key>ProgramArguments</key>\
  <array><string>$PY</string><string>$HOME/stock/server.py</string></array>\
  <key>WorkingDirectory</key><string>$HOME/stock</string>\
  <key>RunAtLoad</key><true/>\
  <key>KeepAlive</key><true/>\
  <key>StandardOutPath</key><string>/tmp/stock.log</string>\
  <key>StandardErrorPath</key><string>/tmp/stock.log</string>\
</dict>\
</plist>\
EOF\
